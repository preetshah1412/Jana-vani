# Backend settings for local development. Copy to backend/.env and adjust if needed.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATA_DIR=.
FRONTEND_ORIGIN=http://localhost:8080
TRUST_PROXY_HOPS=0
COOKIE_SECURE=false

# Optional: a stable, random 32-byte key encoded as hex. Keep it private and back it up.
# BALLOT_KEY=
